 "dialogue": [
  {
   "section": 2,
   "speaker": "children",
   "text": "Can we come in?",
   "start": 20.73
  },
  {
   "section": 3,
   "speaker": "kid_mimic",
   "text": "Come in.",
   "start": 51.94
  },
  {
   "section": 3,
   "speaker": "kid",
   "text": "No.",
   "start": 55.29
  },
  {
   "section": 3,
   "speaker": "kid",
   "text": "You can't come in.",
   "start": 56.14
  },
  {
   "section": 4,
   "speaker": "cerberus",
   "text": "Never let them in.",
   "start": 71.66
  },
  {
   "section": 4,
   "speaker": "cerberus",
   "text": "Go home.",
   "start": 73.54
  },
  {
   "section": 4,
   "speaker": "kid",
   "text": "I won't.",
   "start": 75.21
  },
  {
   "section": 5,
   "speaker": "children",
   "text": "Can we come in?",
   "start": 82.2
  }
 ],
 "sentences": [
  {
   "section": 0,
   "speaker": "narrator",
   "text": "Only one head is awake.",
   "start": 0.0
  },
  {
   "section": 0,
   "speaker": "narrator",
   "text": "Who survives?",
   "start": 1.72
  },
  {
   "section": 1,
   "speaker": "narrator",
   "text": "Tonight, two legends collide.",
   "start": 4.05
  },
  {
   "section": 1,
   "speaker": "narrator",
   "text": "On the left, the Black-Eyed Children.",
   "start": 6.5
  },
  {
   "section": 1,
   "speaker": "narrator",
   "text": "On the right, Cerberus.",
   "start": 9.05
  },
  {
   "section": 1,
   "speaker": "narrator",
   "text": "Who wins?",
   "start": 11.2
  },
  {
   "section": 1,
   "speaker": "narrator",
   "text": "Comment.",
   "start": 12.18
  },
  {
   "section": 2,
   "speaker": "narrator",
   "text": "A kid flees through the woods, until a lamp glows in an abandoned cabin.",
   "start": 13.73
  },
  {
   "section": 2,
   "speaker": "narrator",
   "text": "They slip inside, but a knock comes.",
   "start": 17.85
  },
  {
   "section": 2,
   "speaker": "children",
   "text": "Can we come in?",
   "start": 20.73
  },
  {
   "section": 2,
   "speaker": "narrator",
   "text": "Legend says they cannot enter unless invited.",
   "start": 22.53
  },
  {
   "section": 2,
   "speaker": "narrator",
   "text": "So they repeat it, the lamp dies, and the kid's hand drifts toward the latch.",
   "start": 25.07
  },
  {
   "section": 2,
   "speaker": "narrator",
   "text": "Then the floor glows, and Cerberus, keeper of the gate of the dead, rises.",
   "start": 29.59
  },
  {
   "section": 2,
   "speaker": "narrator",
   "text": "His tail is a serpent, and his drool withers the grass.",
   "start": 34.36
  },
  {
   "section": 2,
   "speaker": "narrator",
   "text": "Legend also says music puts him to sleep.",
   "start": 37.58
  },
  {
   "section": 3,
   "speaker": "narrator",
   "text": "Three heads snap, and the children fly off the porch.",
   "start": 40.3
  },
  {
   "section": 3,
   "speaker": "narrator",
   "text": "They rise unblinking, humming.",
   "start": 43.51
  },
  {
   "section": 3,
   "speaker": "narrator",
   "text": "The lullaby drifts, two heads sag, and one fights sleep.",
   "start": 45.55
  },
  {
   "section": 3,
   "speaker": "narrator",
   "text": "Now they speak in the kid's own voice.",
   "start": 49.32
  },
  {
   "section": 3,
   "speaker": "kid_mimic",
   "text": "Come in.",
   "start": 51.94
  },
  {
   "section": 3,
   "speaker": "narrator",
   "text": "But the kid answers.",
   "start": 53.57
  },
  {
   "section": 3,
   "speaker": "kid",
   "text": "No.",
   "start": 55.29
  },
  {
   "section": 3,
   "speaker": "kid",
   "text": "You can't come in.",
   "start": 56.14
  },
  {
   "section": 3,
   "speaker": "narrator",
   "text": "The song breaks, and all three heads wake.",
   "start": 58.02
  },
  {
   "section": 3,
   "speaker": "narrator",
   "text": "Cerberus seizes them, and the porch splits into a red gate.",
   "start": 60.87
  },
  {
   "section": 3,
   "speaker": "narrator",
   "text": "He drags both children down, and the gate slams shut.",
   "start": 64.32
  },
  {
   "section": 4,
   "speaker": "narrator",
   "text": "Cerberus wins.",
   "start": 67.74
  },
  {
   "section": 4,
   "speaker": "narrator",
   "text": "At dawn, he turns to the kid.",
   "start": 69.24
  },
  {
   "section": 4,
   "speaker": "cerberus",
   "text": "Never let them in.",
   "start": 71.66
  },
  {
   "section": 4,
   "speaker": "cerberus",
   "text": "Go home.",
   "start": 73.54
  },
  {
   "section": 4,
   "speaker": "kid",
   "text": "I won't.",
   "start": 75.21
  },
  {
   "section": 5,
   "speaker": "narrator",
   "text": "But next night, a red glow creeps under the kid's floor.",
   "start": 76.48
  },
  {
   "section": 5,
   "speaker": "narrator",
   "text": "Then, one knock.",
   "start": 79.77
  },
  {
   "section": 5,
   "speaker": "children",
   "text": "Can we come in?",
   "start": 82.2
  },
  {
   "section": 5,
   "speaker": "narrator",
   "text": "Did hell really keep them?",
   "start": 84.01
  },
  {
   "section": 5,
   "speaker": "narrator",
   "text": "Who's next?",
   "start": 85.52
  }
 ]
}