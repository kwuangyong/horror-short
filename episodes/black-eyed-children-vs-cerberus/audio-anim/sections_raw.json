 ],
 "sentences": [
  {
   "section": 0,
   "speaker": "narrator",
   "text": "Only one head is awake.",
   "start": 0.0
  },
  {
   "section": 0,
   "speaker": "narrator",
   "text": "Who survives?",
   "start": 1.62
  },
  {
   "section": 1,
   "speaker": "narrator",
   "text": "Tonight, two legends collide.",
   "start": 3.81
  },
  {
   "section": 1,
   "speaker": "narrator",
   "text": "On the left, the Black-Eyed Children.",
   "start": 6.11
  },
  {
   "section": 1,
   "speaker": "narrator",
   "text": "On the right, Cerberus.",
   "start": 8.51
  },
  {
   "section": 1,
   "speaker": "narrator",
   "text": "Who wins?",
   "start": 10.53
  },
  {
   "section": 1,
   "speaker": "narrator",
   "text": "Comment.",
   "start": 11.45
  },
  {
   "section": 2,
   "speaker": "narrator",
   "text": "A kid flees through the woods, until a lamp glows in an abandoned cabin.",
   "start": 12.9
  },
  {
   "section": 2,
   "speaker": "narrator",
   "text": "They slip inside, but a knock comes.",
   "start": 16.78
  },
  {
   "section": 2,
   "speaker": "children",
   "text": "Can we come in?",
   "start": 19.48
  },
  {
   "section": 2,
   "speaker": "narrator",
   "text": "Legend says they cannot enter unless invited.",
   "start": 21.18
  },
  {
   "section": 2,
   "speaker": "narrator",
   "text": "So they repeat it, the lamp dies, and the kid's hand drifts toward the latch.",
   "start": 23.56
  },
  {
   "section": 2,
   "speaker": "narrator",
   "text": "Then the floor glows, and Cerberus, keeper of the gate of the dead, rises.",
   "start": 27.81
  },
  {
   "section": 2,
   "speaker": "narrator",
   "text": "His tail is a serpent, and his drool withers the grass.",
   "start": 32.29
  },
  {
   "section": 2,
   "speaker": "narrator",
   "text": "Legend also says music puts him to sleep.",
   "start": 35.32
  },
  {
   "section": 3,
   "speaker": "narrator",
   "text": "Three heads snap, and the children fly off the porch.",
   "start": 37.88
  },
  {
   "section": 3,
   "speaker": "narrator",
   "text": "They rise unblinking, humming.",
   "start": 40.89
  },
  {
   "section": 3,
   "speaker": "narrator",
   "text": "The lullaby drifts, two heads sag, and one fights sleep.",
   "start": 42.81
  },
  {
   "section": 3,
   "speaker": "narrator",
   "text": "Now they speak in the kid's own voice.",
   "start": 46.35
  },
  {
   "section": 3,
   "speaker": "kid_mimic",
   "text": "Come in.",
   "start": 48.82
  },
  {
   "section": 3,
   "speaker": "narrator",
   "text": "But the kid answers.",
   "start": 50.35
  },
  {
   "section": 3,
   "speaker": "kid",
   "text": "No.",
   "start": 51.97
  },
  {
   "section": 3,
   "speaker": "kid",
   "text": "You can't come in.",
   "start": 52.76
  },
  {
   "section": 3,
   "speaker": "narrator",
   "text": "The song breaks, and all three heads wake.",
   "start": 54.53
  },
  {
   "section": 3,
   "speaker": "narrator",
   "text": "Cerberus seizes them, and the porch splits into a red gate.",
   "start": 57.21
  },
  {
   "section": 3,
   "speaker": "narrator",
   "text": "He drags both children down, and the gate slams shut.",
   "start": 60.45
  },
  {
   "section": 4,
   "speaker": "narrator",
   "text": "Cerberus wins.",
   "start": 63.67
  },
  {
   "section": 4,
   "speaker": "narrator",
   "text": "At dawn, he turns to the kid.",
   "start": 65.08
  },
  {
   "section": 4,
   "speaker": "cerberus",
   "text": "Never let them in.",
   "start": 67.35
  },
  {
   "section": 4,
   "speaker": "cerberus",
   "text": "Go home.",
   "start": 69.12
  },
  {
   "section": 4,
   "speaker": "kid",
   "text": "I won't.",
   "start": 70.69
  },
  {
   "section": 5,
   "speaker": "narrator",
   "text": "But next night, a red glow creeps under the kid's floor.",
   "start": 71.88
  },
  {
   "section": 5,
   "speaker": "narrator",
   "text": "Then, one knock.",
   "start": 74.97
  },
  {
   "section": 5,
   "speaker": "children",
   "text": "Can we come in?",
   "start": 77.26
  },
  {
   "section": 5,
   "speaker": "narrator",
   "text": "Did hell really keep them?",
   "start": 78.96
  },
  {
   "section": 5,
   "speaker": "narrator",
   "text": "Who's next?",
   "start": 80.38
  }
 ],
